{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tier-definitions.schema.json",
  "title": "Tier definitions",
  "type": "object",
  "required": [
    "schemaVersion",
    "tiers"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "tiers": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "tier",
          "name",
          "nameKey",
          "stageMin",
          "stageMax",
          "keywordEditorId",
          "breakpointTag",
          "budgetStep",
          "unlockTag"
        ],
        "properties": {
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "nameKey": {
            "$ref": "common.schema.json#/$defs/localizationKey"
          },
          "stageMin": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "stageMax": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "keywordEditorId": {
            "type": "string",
            "pattern": "^RF_KW_Tier_[0-9]{2}$"
          },
          "breakpointTag": {
            "type": "string",
            "minLength": 1
          },
          "budgetStep": {
            "type": "integer",
            "minimum": 1
          },
          "unlockTag": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
