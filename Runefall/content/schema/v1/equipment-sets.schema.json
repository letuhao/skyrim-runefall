{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "equipment-sets.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "sets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "setId",
          "roleKey",
          "stageMin",
          "stageMax",
          "itemEditorIds",
          "weight"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "setId": {
            "type": "string"
          },
          "roleKey": {
            "type": "string"
          },
          "stageMin": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "stageMax": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "itemEditorIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "weight": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  }
}
