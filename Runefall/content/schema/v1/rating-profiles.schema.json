{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rating-profiles.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "profileId",
          "baseDPS",
          "baseEHP"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "profileId": {
            "type": "string"
          },
          "baseDPS": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "baseEHP": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "offenseWeight": {
            "type": "number"
          },
          "defenseWeight": {
            "type": "number"
          },
          "utilityWeight": {
            "type": "number"
          },
          "mitigationCap": {
            "type": "number"
          },
          "sustainCap": {
            "type": "number"
          }
        }
      }
    }
  }
}
