{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assignment-rules.schema.json",
  "title": "Stage assignment rules",
  "type": "object",
  "required": [
    "schemaVersion",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ruleId",
          "source",
          "appliesTo",
          "minStage",
          "maxStage",
          "offsetMin",
          "offsetMax",
          "jitter",
          "seedSalt",
          "priority",
          "enabled"
        ],
        "properties": {
          "ruleId": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "enum": [
              "default",
              "worldband",
              "encounter",
              "override",
              "playerrank"
            ]
          },
          "appliesTo": {
            "type": "string"
          },
          "minStage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "maxStage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offsetMin": {
            "type": "integer",
            "minimum": -100,
            "maximum": 100
          },
          "offsetMax": {
            "type": "integer",
            "minimum": -100,
            "maximum": 100
          },
          "jitter": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "seedSalt": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          },
          "enabled": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
