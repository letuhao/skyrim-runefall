{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "race-classification-rules.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "ruleId",
          "keywordEditorId",
          "roleKey",
          "family",
          "hostEligible",
          "protectionEligible",
          "provisional",
          "priority"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "ruleId": {
            "type": "integer",
            "minimum": 1
          },
          "keywordEditorId": {
            "type": "string",
            "minLength": 1
          },
          "roleKey": {
            "type": "string",
            "pattern": "^rf:role/"
          },
          "family": {
            "type": "string"
          },
          "hostEligible": {
            "type": "boolean"
          },
          "protectionEligible": {
            "type": "boolean"
          },
          "provisional": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
