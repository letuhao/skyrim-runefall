{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "economy-profiles.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "profileId",
          "baseItemValue",
          "valuePerIlvl",
          "rarityMultipliers",
          "vendorBuyMultiplier",
          "vendorSellMultiplier",
          "runeValue",
          "materialValue",
          "respecBaseCost",
          "respecCostPerLevel",
          "salvageValuePct"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "profileId": {
            "type": "string"
          },
          "baseItemValue": {
            "type": "number",
            "minimum": 0
          },
          "valuePerIlvl": {
            "type": "number",
            "minimum": 0
          },
          "rarityMultipliers": {
            "type": "string"
          },
          "vendorBuyMultiplier": {
            "type": "number",
            "minimum": 0
          },
          "vendorSellMultiplier": {
            "type": "number",
            "minimum": 0
          },
          "runeValue": {
            "type": "number",
            "minimum": 0
          },
          "materialValue": {
            "type": "number",
            "minimum": 0
          },
          "respecBaseCost": {
            "type": "number",
            "minimum": 0
          },
          "respecCostPerLevel": {
            "type": "number",
            "minimum": 0
          },
          "salvageValuePct": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
