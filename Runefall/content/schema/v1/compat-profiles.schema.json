{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compat-profiles.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "profileId",
          "requiredPlugins",
          "optionalPlugins",
          "lootMode",
          "protectVanillaLoot",
          "notes"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "profileId": {
            "type": "string"
          },
          "requiredPlugins": {
            "type": "string"
          },
          "optionalPlugins": {
            "type": "string"
          },
          "lootMode": {
            "enum": [
              "additive",
              "replace",
              "disabled"
            ]
          },
          "protectVanillaLoot": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
