{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rating-display-profiles.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "profileId",
          "numberVisible",
          "labelVisible"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "profileId": {
            "type": "string"
          },
          "numberVisible": {
            "type": "boolean"
          },
          "labelVisible": {
            "type": "boolean"
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          }
        }
      }
    }
  }
}
