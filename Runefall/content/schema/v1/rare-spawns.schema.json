{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rare-spawns.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "rareSpawns"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "rareSpawns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "rareId",
          "bandId",
          "actorEditorId",
          "chancePermille",
          "stageMin",
          "stageMax",
          "conditionTag",
          "weight",
          "enabled"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "rareId": {
            "type": "string"
          },
          "bandId": {
            "type": "string"
          },
          "actorEditorId": {
            "type": "string"
          },
          "chancePermille": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "stageMin": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "stageMax": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "conditionTag": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
