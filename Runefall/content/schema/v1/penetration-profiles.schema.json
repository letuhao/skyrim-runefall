{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "penetration-profiles.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "profileId",
          "base",
          "per10Stages",
          "cap",
          "mageChannel",
          "weaponChannel",
          "consumableChannel"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "profileId": {
            "type": "string"
          },
          "base": {
            "type": "integer",
            "minimum": 0
          },
          "per10Stages": {
            "type": "integer",
            "minimum": 0
          },
          "cap": {
            "type": "integer",
            "minimum": 0
          },
          "mageChannel": {
            "type": "boolean"
          },
          "weaponChannel": {
            "type": "boolean"
          },
          "consumableChannel": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
