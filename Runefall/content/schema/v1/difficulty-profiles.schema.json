{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "difficulty-profiles.schema.json",
  "title": "Difficulty profiles",
  "type": "object",
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "profileId",
          "name",
          "nameKey",
          "stageDelta",
          "statMult",
          "damageDealtMult",
          "damageTakenMult",
          "xpMult",
          "rewardMult",
          "dropMult",
          "maxStage",
          "enabled"
        ],
        "properties": {
          "profileId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "name": {
            "type": "string"
          },
          "nameKey": {
            "$ref": "common.schema.json#/$defs/localizationKey"
          },
          "stageDelta": {
            "type": "integer",
            "minimum": -100,
            "maximum": 100
          },
          "statMult": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "damageDealtMult": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "damageTakenMult": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "xpMult": {
            "type": "number",
            "minimum": 0
          },
          "rewardMult": {
            "type": "number",
            "minimum": 0
          },
          "dropMult": {
            "type": "number",
            "minimum": 0
          },
          "maxStage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "enabled": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
