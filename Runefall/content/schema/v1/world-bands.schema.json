{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world-bands.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "bands"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "bandId",
          "matchType",
          "matchValue",
          "stageMin",
          "stageMax",
          "rate",
          "exclusions"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "bandId": {
            "type": "string"
          },
          "matchType": {
            "enum": [
              "default",
              "worldspace",
              "cell",
              "encounterZone",
              "location"
            ]
          },
          "matchValue": {
            "type": "string"
          },
          "stageMin": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "stageMax": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "rate": {
            "type": "number",
            "minimum": 0
          },
          "exclusions": {
            "type": "string"
          }
        }
      }
    }
  }
}
