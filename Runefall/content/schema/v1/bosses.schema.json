{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bosses.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "bosses"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "bosses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "bossId",
          "actorEditorId",
          "fixedStage",
          "unique",
          "questBand",
          "packageId",
          "enabled"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "bossId": {
            "type": "string"
          },
          "actorEditorId": {
            "type": "string"
          },
          "fixedStage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "unique": {
            "type": "boolean"
          },
          "questBand": {
            "type": "integer",
            "minimum": 0
          },
          "packageId": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
