{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-perks.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "perks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "perks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "perkId",
          "skill",
          "rankRequired",
          "effectKey",
          "magnitude",
          "descriptionKey"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "perkId": {
            "type": "string"
          },
          "skill": {
            "type": "string"
          },
          "rankRequired": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "effectKey": {
            "type": "string"
          },
          "magnitude": {
            "type": "number"
          },
          "descriptionKey": {
            "type": "string"
          }
        }
      }
    }
  }
}
