{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "encounter-tables.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "encounters"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "encounters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "encounterId",
          "bandId",
          "class",
          "actorEditorId",
          "stageMin",
          "stageMax",
          "weight",
          "maxPerCell",
          "cooldownSeconds",
          "enabled"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "encounterId": {
            "type": "string"
          },
          "bandId": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "actorEditorId": {
            "type": "string"
          },
          "stageMin": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "stageMax": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "maxPerCell": {
            "type": "integer",
            "minimum": 1
          },
          "cooldownSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
