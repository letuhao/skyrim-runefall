{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "endgame-profiles.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "profileId",
          "finalBossId",
          "requiredRank",
          "requiredBossTier",
          "rewardRunes",
          "completionTitleKey",
          "endgameTier"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "profileId": {
            "type": "string"
          },
          "finalBossId": {
            "type": "string"
          },
          "requiredRank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "requiredBossTier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "rewardRunes": {
            "type": "integer",
            "minimum": 0
          },
          "completionTitleKey": {
            "type": "string"
          },
          "endgameTier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        }
      }
    }
  }
}
