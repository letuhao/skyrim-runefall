{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anomaly-families.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "families"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "family",
          "nameKey",
          "stageOffset",
          "tierLabels",
          "coreItemEditorId",
          "trophyItemEditorId",
          "encounterActorEditorId",
          "enabled"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "family": {
            "type": "string"
          },
          "nameKey": {
            "type": "string"
          },
          "stageOffset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          },
          "tierLabels": {
            "type": "string"
          },
          "coreItemEditorId": {
            "type": "string"
          },
          "trophyItemEditorId": {
            "type": "string"
          },
          "encounterActorEditorId": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
