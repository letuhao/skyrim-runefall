{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "player-progression.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "pointsPerLevel",
    "maxRuneLevel",
    "breakthroughBonuses",
    "xpBase",
    "xpGrowth",
    "bossBreakEvery"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "pointsPerLevel": {
      "type": "integer",
      "minimum": 0
    },
    "maxRuneLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "breakthroughBonuses": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 10,
      "maxItems": 10
    },
    "xpBase": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "xpGrowth": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bossBreakEvery": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  },
  "additionalProperties": true
}
